# ============================================================
# Node-side / tooling variables for apps/backend (copy to .env).
# Worker secrets (Clerk keys) live in .dev.vars — see .dev.vars.example.
#
# wrangler loads .env into process.env; drizzle.config.ts and
# vitest.config.mts load it themselves.
# ============================================================

# Neon connection string (direct, not pooled) — used by `db:migrate`.
DATABASE_URL=

# Postgres that `wrangler dev` connects to in place of Hyperdrive.
# Point at a Neon dev branch (or a local Postgres).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Neon branch dedicated to tests — `pnpm --filter backend test` writes to it.
# Migrate it with `pnpm --filter backend db:migrate:test`.
TEST_DATABASE_URL=
