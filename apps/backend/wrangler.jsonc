{
  "name": "scaffold-worker",
  "main": "src/index.ts",
  // DEV_NOTE: keep it up to date with the current date.
  "compatibility_date": "2026-05-22",
  // DEV_NOTE: nodejs_compat flag is needed for using AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_CORS_ORIGIN": "http://localhost:3000",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // DEV_NOTE: Hyperdrive pools connections to Neon. Create the config with
  // `wrangler hyperdrive create scaffold-db --connection-string="<neon-connection-string>"`
  // and put the returned id below (and in each env). Local dev and tests skip Hyperdrive and connect
  // straight to Postgres via CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (see .env.example).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
    },
  ],
  "env": {
    "staging": {
      "name": "scaffold-worker-staging",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "http://localhost:3000,https://scaffold-web-staging.hatiprithwish.workers.dev",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "REPLACE_WITH_HYPERDRIVE_ID",
        },
      ],
    },
    "production": {
      "name": "scaffold-worker",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "https://scaffold-web.hatiprithwish.workers.dev",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "REPLACE_WITH_HYPERDRIVE_ID",
        },
      ],
    },
  },
}
