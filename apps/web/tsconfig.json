{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@schemas/*": ["../../packages/schemas/src/*"],
      "@app/schemas": ["../../packages/schemas/src/index.ts"]
    }
  },
  "include": ["src"]
}
